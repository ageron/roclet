{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roclet-packages",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "preview_urls": false,
  "cache": {"enabled": true},
  "ratelimits": [{
    "name": "PACKAGE_RATE_LIMITER",
    "namespace_id": "731001",
    "simple": {"limit": 60, "period": 60}
  }],
  "observability": {"enabled": false}
}

+test "structured module debug replay retains checked root provenance" {
+    const Observer = struct {
+        count: usize = 0,
+        fn notify(context: *anyopaque, event: ModuleRootEvent) void {
+            const self: *@This() = @ptrCast(@alignCast(context));
+            std.debug.assert(event.root.? == @as(checked.ComptimeRootId, @fromBackingInt(2)));
+            std.debug.assert(@backingInt(event.source.?.def) == 7);
+            std.debug.assert(event.region == null);
+            std.debug.assert(std.mem.eql(u8, event.message, "same text is not an identity"));
+            self.count += 1;
+        }
+    };
+    var events: DebugEvents = .{ .allocator = std.testing.allocator };
+    defer events.deinit();
+    try events.events.append(std.testing.allocator, .{
+        .module = std.mem.zeroes(checked.ModuleId),
+        .root = @fromBackingInt(2),
+        .source = .{ .def = @fromBackingInt(7) },
+        .sequence = 0,
+        .is_repl = false,
+        .message = try std.testing.allocator.dupe(u8, "same text is not an identity"),
+    });
+    var observer: Observer = .{};
+    try events.replay(.{ .module_root_event_callback = .{ .context = &observer, .notify = Observer.notify } });
+    try std.testing.expectEqual(@as(usize, 1), observer.count);
+}

+test "module debug observer receives non-REPL and REPL replay exactly once" {
+    const Observer = struct {
+        count: usize = 0,
+        fn notify(context: *anyopaque, event: EventView) void {
+            const self: *@This() = @ptrCast(@alignCast(context));
+            switch (event) {
+                .dbg => |message| {
+                    std.debug.assert(std.mem.eql(u8, message, "observation"));
+                    self.count += 1;
+                },
+            }
+        }
+    };
+    var modules: Observer = .{};
+    var repl: Observer = .{};
+    const options: Options = .{
+        .module_event_callback = .{ .context = &modules, .notify = Observer.notify },
+        .event_callback = .{ .context = &repl, .notify = Observer.notify },
+    };
+    try emitDebugMessage(std.testing.allocator, options, false, "observation");
+    try std.testing.expectEqual(@as(usize, 1), modules.count);
+    try std.testing.expectEqual(@as(usize, 0), repl.count);
+    try emitDebugMessage(std.testing.allocator, options, true, "observation");
+    try std.testing.expectEqual(@as(usize, 2), modules.count);
+    try std.testing.expectEqual(@as(usize, 1), repl.count);
+}
+
+test "structured module debug replay retains checked root provenance" {
+    const Observer = struct {
+        count: usize = 0,
+        fn notify(context: *anyopaque, event: ModuleRootEvent) void {
+            const self: *@This() = @ptrCast(@alignCast(context));
+            std.debug.assert(event.root.? == @as(checked.ComptimeRootId, @fromBackingInt(2)));
+            std.debug.assert(@backingInt(event.source.?.def) == 7);
+            std.debug.assert(event.region == null);
+            std.debug.assert(std.mem.eql(u8, event.message, "same text is not an identity"));
+            self.count += 1;
+        }
+    };
+    var events: DebugEvents = .{ .allocator = std.testing.allocator };
+    defer events.deinit();
+    try events.events.append(std.testing.allocator, .{
+        .module = std.mem.zeroes(checked.ModuleId),
+        .root = @fromBackingInt(2),
+        .source = .{ .def = @fromBackingInt(7) },
+        .sequence = 0,
+        .is_repl = false,
+        .message = try std.testing.allocator.dupe(u8, "same text is not an identity"),
+    });
+    var observer: Observer = .{};
+    try events.replay(.{ .module_root_event_callback = .{ .context = &observer, .notify = Observer.notify } });

+/// Parse a notebook fragment using the normal tokenizer and file structure,
+/// accepting expression statements for the embedding frontend to lower into
+/// declarations. Ordinary compilation continues to use `file`.
+pub fn notebook(gpa: Allocator, env: *CommonEnv) Allocator.Error!*AST {
+    return try runTokenDispatch(gpa, env, notebookRootNode);
+}
+
+fn notebookRootNode(parser: *Parser) Allocator.Error!u32 {
+    parser.allow_top_level_expressions = true;
+    try parser.runFile();
+    return 0;
+}
+
+test "notebook expressions and imports preserve ordinary file grammar" {
+    const a = std.testing.allocator;
+    var env = try CommonEnv.init(a, "import Geometry\nwidth = 5\nwidth * 3\n");
+    defer env.deinit(a);
+    const fragment = try notebook(a, &env);
+    defer fragment.deinit();
+    try std.testing.expectEqual(@as(usize, 0), fragment.parse_diagnostics.items.len);
+    const statements = fragment.store.statementSlice(fragment.store.getFile().statements);
+    try std.testing.expectEqual(@as(usize, 3), statements.len);
+    try std.testing.expect(fragment.store.getStatement(statements[0]) == .import);
+    try std.testing.expect(fragment.store.getStatement(statements[1]) == .decl);
+    try std.testing.expect(fragment.store.getStatement(statements[2]) == .expr);
+    const ordinary = try file(a, &env);
+    defer ordinary.deinit();
+    try std.testing.expect(ordinary.parse_diagnostics.items.len > 0);
+}
